# Copy this file to .env and fill in real values. Never commit .env.
#
# KeeperHub is the ONLY onchain execution layer for this project.
# Aegis never holds a private key and never signs or broadcasts a
# transaction itself — it authenticates to KeeperHub with an
# organization API key and lets KeeperHub do the execution.

# Organization API key from KeeperHub (starts with "kh_").
# Create one at https://app.keeperhub.com under Organization > API Keys.
KEEPERHUB_API_KEY=kh_your_api_key_here

# KeeperHub REST API base URL. Endpoint paths already include "/api",
# do not append it here.
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# KeeperHub MCP server endpoint, reserved for later phases.
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Request timeout (seconds) for calls to KeeperHub.
KEEPERHUB_TIMEOUT_SECONDS=10

# Comma-separated allowlist of chain IDs Aegis is permitted to act on.
# Defaults to public testnets only — mainnet chain IDs are rejected
# unless explicitly added here.
# 11155111 = Ethereum Sepolia, 84532 = Base Sepolia, 421614 = Arbitrum Sepolia
AEGIS_ALLOWED_CHAIN_IDS=11155111,84532,421614

# Logging: DEBUG, INFO, WARNING, ERROR
AEGIS_LOG_LEVEL=INFO

# Logging output format: text or json
AEGIS_LOG_FORMAT=text

# Comma-separated CORS allowlist for aegis.api (the dashboard backend) —
# origins allowed to call GET/POST /api/runs. Defaults to the local dev
# frontend only (http://localhost:3000) if unset. Set this to the real
# deployed frontend origin(s) before any non-local deployment — never "*",
# since even a LIVE_DRY_RUN request makes real KeeperHub REST calls
# against this org's API key.
AEGIS_ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# Comma-separated closed set of decisions the policy engine approves.
AEGIS_ALLOWED_DECISIONS=DO_NOTHING,REPAY_DEBT,ADD_COLLATERAL

# Comma-separated closed set of KeeperHub protocol actionType strings the
# policy engine approves. Scoped to Aave V3 read/repay/supply only.
AEGIS_ALLOWED_PROTOCOL_ACTIONS=aave-v3/get-user-account-data,aave-v3/get-user-reserve-data,aave-v3/repay,aave-v3/supply

# The KeeperHub-authorized EXECUTION wallet, kept separate from whichever
# USER WALLET a visitor connects in the browser (see frontend/lib/wallet.ts
# and aegis.api.UserWallet). Two roles:
#   1. Policy engine's wallet-pin: any intent whose on_behalf_of address
#      does not match this wallet is rejected, so connecting an
#      unauthorized wallet can never result in a real execution.
#   2. Dev-only fallback: LIVE_DRY_RUN/LIVE_EXECUTION use this to read a
#      position ONLY when nobody has connected a wallet in the browser —
#      the dashboard labels this explicitly as "Dev default wallet", never
#      as the visitor's own. Fine to leave set in dev/test config; a real
#      multi-user deployment should rely on connected wallets instead.
AEGIS_EXPECTED_WALLET_ADDRESS=

# Blunt, asset-agnostic cap on Intent.amount (human units).
AEGIS_MAX_TX_AMOUNT=100

# Aave V3 health factor (human units) below which a position is AT_RISK.
AEGIS_HEALTH_FACTOR_THRESHOLD=1.5

# Asset the pipeline proposes repaying/supplying when a position is
# AT_RISK. Required for `aegis demo` / `aegis run` unless passed as
# --debt-asset/--collateral-asset on the command line.
AEGIS_DEBT_ASSET=
AEGIS_COLLATERAL_ASSET=

# Known available wallet balance (base-currency-equivalent units) the
# pipeline checks candidate amounts against. Leave unset to skip the
# balance-sufficiency execution signal.
AEGIS_AVAILABLE_BALANCE=

# Anthropic API key for Hermes's real LLM client. Never a KeeperHub or
# wallet credential. Only required if you construct AnthropicLlmClient;
# the test suite does not need it.
ANTHROPIC_API_KEY=

# Anthropic model id Hermes uses for READ/ANALYZE/DECIDE.
AEGIS_HERMES_MODEL=claude-sonnet-5

# Opt-in switch: when true (and ANTHROPIC_API_KEY is set), LIVE_DRY_RUN
# and LIVE_EXECUTION runs consult Hermes and add its proposal as one
# additional candidate, scored and gated identically to every other one.
# False by default — candidate generation stays purely deterministic.
AEGIS_HERMES_ENABLED=false

# Master switch for real (non-simulated) execution from the Aegis loop.
# Leave this false: the loop always simulates a policy-approved intent but
# will not execute for real until this is explicitly turned on.
AEGIS_AUTONOMOUS_EXECUTION_ENABLED=false

# JSON-lines audit file every aegis.demo_orchestrator run appends to.
# Shared across processes so the dashboard API can poll a run started by a
# separate CLI invocation (e.g. `aegis live-demo --confirm`).
AEGIS_AUDIT_LOG_PATH=./aegis_runs.jsonl
