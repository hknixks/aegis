# Copy this file to .env and fill in real values. Never commit .env.
#
# KeeperHub is the ONLY onchain execution layer for this project.
# Aegis never holds a private key and never signs or broadcasts a
# transaction itself — it authenticates to KeeperHub with an
# organization API key and lets KeeperHub do the execution.

# Organization API key from KeeperHub (starts with "kh_").
# Create one at https://app.keeperhub.com under Organization > API Keys.
KEEPERHUB_API_KEY=kh_your_api_key_here

# KeeperHub REST API base URL. Endpoint paths already include "/api",
# do not append it here.
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# KeeperHub MCP server endpoint, reserved for later phases.
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Request timeout (seconds) for calls to KeeperHub.
KEEPERHUB_TIMEOUT_SECONDS=10

# Comma-separated allowlist of chain IDs Aegis is permitted to act on.
# Defaults to public testnets only — mainnet chain IDs are rejected
# unless explicitly added here.
# 11155111 = Ethereum Sepolia, 84532 = Base Sepolia, 421614 = Arbitrum Sepolia
AEGIS_ALLOWED_CHAIN_IDS=11155111,84532,421614

# Logging: DEBUG, INFO, WARNING, ERROR
AEGIS_LOG_LEVEL=INFO

# Logging output format: text or json
AEGIS_LOG_FORMAT=text
